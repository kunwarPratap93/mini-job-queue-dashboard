# ── Server Configuration ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset or empty to use local SQLite (database.sqlite).
# For PostgreSQL in production (e.g. Render, Supabase, Neon, Railway):
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Set to false only if your PostgreSQL provider does not use SSL
DATABASE_SSL=true
